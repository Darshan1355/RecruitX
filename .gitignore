# ============================================
# RecruitX Master GitIgnore Configuration
# ============================================

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# Production build artifacts
dist/
client/dist/
build/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
coverage/
.nyc_output/

# Server runtime uploads & temporary test files
server/uploads/*.pdf
server/uploads/*.docx
server/uploads/*.doc
!server/uploads/.gitkeep
test_upload_temp.pdf

# SQLite Databases (preserves schema & migrations)
*.sqlite3
*.sqlite3-journal
server/data/*.sqlite3
server/data/*.sqlite3-journal
!server/data/.gitkeep
ai_service/data/resume_db/*.sqlite3
ai_service/data/resume_db/*.sqlite3-journal
ai_service/data/resume_db/**
!ai_service/data/resume_db/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
